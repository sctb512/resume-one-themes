{
  "formatVersion": 2,
  "id": "community-elegant",
  "name": "Elegant",
  "description": "静态迁移适配版；已支持的视觉规则尽量保留，差异见同目录 MIGRATION.json。",
  "version": "1.1.0",
  "license": "MIT",
  "layout": "classic",
  "colors": {
    "accent": "#334155",
    "seal": "#334155",
    "paper": "#FFFFFF",
    "canvas": "#F5F3EE",
    "ink": "#333C47",
    "muted": "#4E5A68",
    "border": "#CED5DC",
    "sidebar": "#F0F2F4"
  },
  "modules": [
    "basics",
    "work",
    "volunteer",
    "education",
    "awards",
    "certificates",
    "publications",
    "skills",
    "languages",
    "interests",
    "references",
    "projects"
  ],
  "typography": {
    "body": {
      "family": "cjk-sans",
      "sizePt": 10.55,
      "weight": 400,
      "lineHeight": 1.42,
      "color": "#333C47"
    },
    "name": {
      "family": "cjk-sans",
      "sizePt": 27,
      "weight": 400,
      "lineHeight": 1.16,
      "color": "#263545"
    },
    "label": {
      "family": "cjk-sans",
      "sizePt": 11.1,
      "weight": 400,
      "lineHeight": 1.3,
      "color": "#4E5A68"
    },
    "summary": {
      "family": "cjk-sans",
      "sizePt": 10.6,
      "weight": 400,
      "lineHeight": 1.43,
      "color": "#333C47"
    },
    "sectionTitle": {
      "family": "cjk-serif",
      "sizePt": 12.7,
      "weight": 600,
      "lineHeight": 1.25,
      "color": "#334155",
      "fontStyle": "normal"
    },
    "itemTitle": {
      "family": "cjk-sans",
      "sizePt": 11.55,
      "weight": 400,
      "lineHeight": 1.3,
      "color": "#263545"
    },
    "meta": {
      "family": "cjk-sans",
      "sizePt": 9.3,
      "weight": 400,
      "lineHeight": 1.3,
      "color": "#4E5A68"
    },
    "sideDate": {
      "family": "cjk-sans",
      "sizePt": 9.2,
      "weight": 400,
      "lineHeight": 1.27,
      "color": "#4E5A68"
    }
  },
  "page": {
    "marginsMm": {
      "top": 16,
      "right": 16,
      "bottom": 16,
      "left": 16
    },
    "firstLinePosition": "line-box",
    "sectionGapMm": 4.4
  },
  "composition": {
    "preset": "sidebar-left",
    "sidebarWidthPct": 32,
    "placements": {
      "skills": "sidebar",
      "languages": "sidebar",
      "interests": "sidebar",
      "certificates": "sidebar"
    },
    "contactRegion": "sidebar",
    "headerRegion": "main",
    "summaryRegion": "main",
    "gapMm": 5.5,
    "contact": "stacked",
    "sidebarTypographyScale": 0.96
  },
  "sections": {
    "awards": {
      "items": "stack"
    },
    "certificates": {
      "items": "compact"
    },
    "education": {
      "items": "stack",
      "heading": "line"
    },
    "interests": {
      "items": "compact"
    },
    "languages": {
      "items": "compact"
    },
    "projects": {
      "items": "stack",
      "heading": "line"
    },
    "publications": {
      "items": "stack"
    },
    "references": {
      "items": "stack"
    },
    "skills": {
      "items": "compact"
    },
    "volunteer": {
      "items": "stack"
    },
    "work": {
      "items": "stack",
      "heading": "line"
    }
  },
  "provenance": {
    "migratedBy": "resume-one-theme-migrate --adapt",
    "fidelity": "adapted",
    "upstreamLicense": "MIT",
    "upstreamAuthor": "Mudassir Ali",
    "upstreamUrl": "https://www.npmjs.com/package/jsonresume-theme-elegant/v/1.16.1",
    "upstreamRevision": "1.16.1"
  }
}
