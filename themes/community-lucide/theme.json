{
  "formatVersion": 2,
  "id": "community-lucide",
  "name": "Lucide",
  "description": "静态迁移适配版；已支持的视觉规则尽量保留，差异见同目录 MIGRATION.json。",
  "version": "1.1.0",
  "license": "MIT",
  "layout": "classic",
  "colors": {
    "accent": "#334155",
    "seal": "#334155",
    "paper": "#FFFFFF",
    "canvas": "#F5F3EE",
    "ink": "#333333",
    "muted": "#64748B",
    "border": "#B8CFDF",
    "sidebar": "#0863A5"
  },
  "modules": [
    "basics",
    "work",
    "volunteer",
    "education",
    "awards",
    "certificates",
    "publications",
    "skills",
    "languages",
    "interests",
    "references",
    "projects"
  ],
  "typography": {
    "body": {
      "family": "cjk-sans",
      "sizePt": 10.25,
      "weight": 400,
      "lineHeight": 1.44
    },
    "name": {
      "family": "cjk-serif",
      "sizePt": 30,
      "weight": 600,
      "lineHeight": 1.14,
      "color": "#0863A5",
      "fontStyle": "normal"
    },
    "label": {
      "family": "cjk-sans",
      "sizePt": 11.25,
      "weight": 400,
      "lineHeight": 1.35
    },
    "summary": {
      "family": "cjk-sans",
      "sizePt": 10.75,
      "weight": 400,
      "lineHeight": 1.46
    },
    "sectionTitle": {
      "family": "cjk-serif",
      "sizePt": 12.5,
      "weight": 600,
      "lineHeight": 1.28,
      "fontStyle": "normal"
    },
    "itemTitle": {
      "family": "cjk-serif",
      "sizePt": 11.25,
      "weight": 600,
      "lineHeight": 1.3,
      "fontStyle": "normal"
    },
    "meta": {
      "family": "cjk-sans",
      "sizePt": 9.5,
      "weight": 400,
      "lineHeight": 1.36
    },
    "sideDate": {
      "family": "cjk-sans",
      "sizePt": 9.5,
      "weight": 400,
      "lineHeight": 1.34
    }
  },
  "page": {
    "marginsMm": {
      "top": 14,
      "right": 14,
      "bottom": 14,
      "left": 14
    },
    "sectionGapMm": 4.6,
    "firstLinePosition": "line-box",
    "size": "A4"
  },
  "composition": {
    "preset": "sidebar-left",
    "sidebarWidthPct": 33,
    "gapMm": 5,
    "placements": {
      "skills": "sidebar",
      "languages": "sidebar",
      "interests": "sidebar",
      "certificates": "sidebar"
    },
    "contactRegion": "sidebar",
    "headerRegion": "main",
    "summaryRegion": "main",
    "contact": "stacked"
  },
  "sections": {
    "skills": {
      "items": "compact"
    }
  },
  "provenance": {
    "migratedBy": "resume-one-theme-migrate --adapt",
    "fidelity": "adapted",
    "upstreamLicense": "MIT",
    "upstreamAuthor": "Clement Cauet",
    "upstreamUrl": "https://www.npmjs.com/package/jsonresume-theme-lucide/v/1.1.0",
    "upstreamRevision": "1.1.0"
  }
}