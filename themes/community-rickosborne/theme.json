{
  "formatVersion": 2,
  "id": "community-rickosborne",
  "name": "Rickosborne",
  "description": "静态迁移适配版；已支持的视觉规则尽量保留，差异见同目录 MIGRATION.json。",
  "version": "1.1.0",
  "license": "CC-BY-NC-SA-4.0",
  "layout": "classic",
  "colors": {
    "accent": "#444444",
    "seal": "#334155",
    "paper": "#FFFFFF",
    "canvas": "#F5F3EE",
    "ink": "#444444",
    "muted": "#666666",
    "border": "#CBD5E1",
    "sidebar": "#F4F3F0"
  },
  "modules": [
    "basics",
    "work",
    "volunteer",
    "education",
    "awards",
    "certificates",
    "publications",
    "skills",
    "languages",
    "interests",
    "references",
    "projects"
  ],
  "typography": {
    "body": {
      "family": "cjk-sans",
      "sizePt": 10.75,
      "weight": 400,
      "lineHeight": 1.43,
      "fontStyle": "normal",
      "color": "#444444"
    },
    "name": {
      "family": "cjk-serif",
      "sizePt": 25,
      "weight": 600,
      "lineHeight": 1.2,
      "color": "#222222",
      "fontStyle": "normal"
    },
    "label": {
      "family": "cjk-sans",
      "sizePt": 10.75,
      "weight": 400,
      "lineHeight": 1.35,
      "color": "#444444"
    },
    "summary": {
      "family": "cjk-sans",
      "sizePt": 10.75,
      "weight": 400,
      "lineHeight": 1.45,
      "color": "#222222"
    },
    "sectionTitle": {
      "family": "cjk-sans",
      "sizePt": 12,
      "weight": 400,
      "lineHeight": 1.28,
      "textTransform": "uppercase",
      "color": "#444444",
      "trackingEm": 0.055
    },
    "itemTitle": {
      "family": "cjk-sans",
      "sizePt": 11.25,
      "weight": 400,
      "lineHeight": 1.33,
      "color": "#222222"
    },
    "meta": {
      "family": "cjk-sans",
      "sizePt": 9.5,
      "weight": 400,
      "lineHeight": 1.34,
      "trackingEm": -0.05,
      "color": "#666666"
    },
    "sideDate": {
      "family": "cjk-sans",
      "sizePt": 9.25,
      "weight": 400,
      "lineHeight": 1.32,
      "color": "#222222"
    }
  },
  "page": {
    "marginsMm": {
      "top": 17,
      "right": 16,
      "bottom": 17,
      "left": 16
    },
    "avoidSplitItems": false,
    "firstLinePosition": "line-box",
    "size": "A4",
    "sectionGapMm": 5.3
  },
  "composition": {
    "preset": "sidebar-right",
    "sidebarWidthPct": 32,
    "placements": {
      "skills": "sidebar",
      "languages": "sidebar",
      "interests": "sidebar",
      "certificates": "sidebar"
    },
    "contactRegion": "sidebar",
    "headerRegion": "main",
    "summaryRegion": "main",
    "sidebarTypographyScale": 0.96,
    "contact": "stacked"
  },
  "sections": {},
  "provenance": {
    "migratedBy": "resume-one-theme-migrate --adapt",
    "fidelity": "adapted",
    "upstreamLicense": "CC-BY-NC-SA-4.0",
    "upstreamAuthor": "Rick Osborne (https://rickosborne.org)",
    "upstreamUrl": "https://www.npmjs.com/package/jsonresume-theme-rickosborne/v/2022.9.16-T1450",
    "upstreamRevision": "2022.9.16-T1450"
  }
}