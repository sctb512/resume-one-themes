{
  "formatVersion": 2,
  "id": "community-colophon",
  "name": "Colophon",
  "description": "静态迁移适配版；已支持的视觉规则尽量保留，差异见同目录 MIGRATION.json。",
  "version": "1.1.0",
  "license": "MIT",
  "layout": "classic",
  "colors": {
    "accent": "#4B4741",
    "seal": "#334155",
    "paper": "#FFFFFF",
    "canvas": "#F5F3EE",
    "ink": "#303030",
    "muted": "#67625B",
    "border": "#D4D0CA"
  },
  "modules": [
    "basics",
    "work",
    "volunteer",
    "education",
    "awards",
    "certificates",
    "publications",
    "skills",
    "languages",
    "interests",
    "references",
    "projects"
  ],
  "typography": {
    "body": {
      "family": "cjk-sans",
      "sizePt": 10.2,
      "weight": 400,
      "lineHeight": 1.42,
      "color": "#303030"
    },
    "name": {
      "family": "cjk-sans",
      "sizePt": 28,
      "weight": 400,
      "lineHeight": 1.19,
      "trackingEm": -0.02,
      "color": "#161616",
      "fontStyle": "normal"
    },
    "label": {
      "family": "cjk-sans",
      "sizePt": 10.5,
      "weight": 400,
      "lineHeight": 1.31,
      "color": "#67625B"
    },
    "summary": {
      "family": "cjk-sans",
      "sizePt": 10.45,
      "weight": 400,
      "lineHeight": 1.44,
      "color": "#161616"
    },
    "sectionTitle": {
      "family": "cjk-serif",
      "sizePt": 11.3,
      "weight": 600,
      "lineHeight": 1.26,
      "trackingEm": 0.025,
      "color": "#4B4741",
      "fontStyle": "normal"
    },
    "itemTitle": {
      "family": "cjk-sans",
      "sizePt": 11,
      "weight": 400,
      "lineHeight": 1.31,
      "trackingEm": -0.004,
      "color": "#161616"
    },
    "meta": {
      "family": "cjk-sans",
      "sizePt": 9.2,
      "weight": 400,
      "lineHeight": 1.3,
      "color": "#67625B"
    },
    "sideDate": {
      "family": "cjk-sans",
      "sizePt": 9.2,
      "weight": 400,
      "lineHeight": 1.28,
      "color": "#161616"
    }
  },
  "page": {
    "marginsMm": {
      "top": 15,
      "right": 17,
      "bottom": 15,
      "left": 17
    },
    "avoidSplitItems": true,
    "keepHeadingWithFirstItem": true,
    "sectionGapMm": 4.2,
    "firstLinePosition": "line-box"
  },
  "composition": {
    "preset": "single-column"
  },
  "sections": {},
  "provenance": {
    "migratedBy": "resume-one-theme-migrate --adapt",
    "fidelity": "adapted",
    "upstreamLicense": "MIT",
    "upstreamAuthor": "David Nelson (https://github.com/dmnelson)",
    "upstreamUrl": "https://www.npmjs.com/package/jsonresume-theme-colophon/v/0.2.0",
    "upstreamRevision": "0.2.0"
  }
}
