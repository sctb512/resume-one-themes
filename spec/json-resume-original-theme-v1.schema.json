{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume One Original JSON Resume Theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "formatVersion", "id", "name", "package", "version", "license", "author", "upstream", "script"],
  "properties": {
    "kind": { "const": "json-resume-original" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "package": { "type": "string", "pattern": "^(@[a-z0-9_.-]+/)?[a-z0-9_.-]+$", "maxLength": 160 },
    "version": { "type": "string", "pattern": "^[0-9][0-9A-Za-z.+-]*$", "maxLength": 64 },
    "license": { "type": "string", "minLength": 1, "maxLength": 160 },
    "author": { "type": "string", "minLength": 1, "maxLength": 200 },
    "upstream": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 300 },
    "stylesheets": {
      "type": "object",
      "maxProperties": 12,
      "propertyNames": { "pattern": "^https://[^\\s]+$", "maxLength": 300 },
      "additionalProperties": { "type": "string", "maxLength": 524288 }
    },
    "script": { "type": "string", "minLength": 1, "maxLength": 1048576 }
  }
}
